      // Zero get()/exists() in allow list: evaluates existing() directly
      allow list: if isSignedIn() &&
        (existing().status == 'active' ||
          existing().sellerId == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidCanopyPaypalItem(incoming()) &&
        incoming().sellerId == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().stockCount >= 1 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (exists(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)) ||
          existsAfter(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)));

      allow update: if (
        isVerifiedUser() &&
        isValidId(itemId) &&
        isValidCanopyPaypalItem(incoming()) &&
        incoming().sellerId == existing().sellerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Seller Updates Active or Sold-Out Canopy Work
          (existing().sellerId == request.auth.uid &&
            existing().status in ['active', 'sold_out'] &&
            incoming().status in ['active', 'sold_out'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sellerName',
              'title',
              'tradeCategory',
              'materialsSpec',
              'craftStory',
              'sellerBenchTag',
              'priceCents',
              'stockCount',
              'status',
              'updatedAt'
            ])) ||
          // Action 2: Seller Archives Canopy Listing (Terminal State)
          (existing().sellerId == request.auth.uid &&
            existing().status in ['active', 'sold_out'] &&
            incoming().status == 'archived' &&
            incoming().sellerName == existing().sellerName &&
            incoming().title == existing().title &&
            incoming().tradeCategory == existing().tradeCategory &&
            incoming().materialsSpec == existing().materialsSpec &&
            incoming().craftStory == existing().craftStory &&
            incoming().sellerBenchTag == existing().sellerBenchTag &&
            incoming().priceCents == existing().priceCents &&
            incoming().stockCount == 0 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stockCount',
              'status',
              'updatedAt'
            ])) ||
          // Action 3: Verified Buyer Decrements Stock Upon PayPal / Counter Purchase
          (existing().sellerId != request.auth.uid &&
            existing().status == 'active' &&
            incoming().sellerName == existing().sellerName &&
            incoming().title == existing().title &&
            incoming().tradeCategory == existing().tradeCategory &&
            incoming().materialsSpec == existing().materialsSpec &&
            incoming().craftStory == existing().craftStory &&
            incoming().sellerBenchTag == existing().sellerBenchTag &&
            incoming().priceCents == existing().priceCents &&
            incoming().stockCount < existing().stockCount &&
            incoming().stockCount >= 0 &&
            incoming().status == (incoming().stockCount == 0 ? 'sold_out' : 'active') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stockCount',
              'status',
              'updatedAt'
            ]))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(itemId) &&
        existing().sellerId == request.auth.uid) ||
        (isAdmin() && isValidId(itemId));
    }

    // Collection 20: 0m Welcome Area Shoe & Wellington Boot Character Profiles (Owner-Isolated)
    match /shoeCharacters/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin()) &&
        (resource == null || existing().uid == userId);

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidShoeCharacterProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidShoeCharacterProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (userId == request.auth.uid &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'shoeKind',
              'colorway',
              'characterNickname',
              'updatedAt'
            ]))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().uid == request.auth.uid) ||
        (isAdmin() && isValidId(userId));
    }

    // Collection 21: 33m Mezzanine Private Sensory Chill Pods (Strictly 1 Per Person)
    match /chillPodOccupancy/{podId} {
      allow get: if isSignedIn() &&
        isValidId(podId) &&
        podId in ['pod_1', 'pod_2', 'pod_3', 'pod_4'];

      // Zero get()/exists() in allow list: evaluates existing() directly
      allow list: if isSignedIn() &&
        existing().podId in ['pod_1', 'pod_2', 'pod_3', 'pod_4'];

      allow create: if isVerifiedUser() &&
        isValidId(podId) &&
        podId in ['pod_1', 'pod_2', 'pod_3', 'pod_4'] &&
        isValidChillPodState(incoming()) &&
        incoming().podId == podId &&
        incoming().occupancyStatus == 'occupied' &&
        incoming().occupantId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(podId) &&
        podId in ['pod_1', 'pod_2', 'pod_3', 'pod_4'] &&
        isValidChillPodState(incoming()) &&
        incoming().podId == existing().podId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Verified Member Enters a Vacant (or >2h Stale) Pod — Strictly 1 Per Person
          ((existing().occupancyStatus == 'vacant' ||
              request.time > existing().updatedAt + duration.value(2, 'h')) &&
            incoming().occupancyStatus == 'occupied' &&
            incoming().occupantId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'podLabel',
              'occupantId',
              'occupantName',
              'occupancyStatus',
              'fanEnabled',
              'heaterEnabled',
              'lightsOffCalm',
              'flotationEnabled',
              'quiltType',
              'updatedAt'
            ])) ||
          // Action 2: Current Occupant Toggles Sensory Controls (Fan, Heater, Lights-Off Calm, Water Flotation, Vegan/Natural Duck Feather Quilt)
          (existing().occupancyStatus == 'occupied' &&
            existing().occupantId == request.auth.uid &&
            incoming().occupancyStatus == 'occupied' &&
            incoming().occupantId == request.auth.uid &&
            incoming().podLabel == existing().podLabel &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'occupantName',
              'fanEnabled',
              'heaterEnabled',
              'lightsOffCalm',
              'flotationEnabled',
              'quiltType',
              'updatedAt'
            ])) ||
          // Action 3: Current Occupant Steps Out / Vacates Pod (Resets All Sensory Switches Off)
          (existing().occupancyStatus == 'occupied' &&
            existing().occupantId == request.auth.uid &&
            incoming().occupancyStatus == 'vacant' &&
            incoming().podLabel == existing().podLabel &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'occupantId',
              'occupantName',
              'occupancyStatus',
              'fanEnabled',
              'heaterEnabled',
              'lightsOffCalm',
              'flotationEnabled',
              'quiltType',
              'updatedAt'
            ]))
        )
      );

      allow delete: if isAdmin() &&
        isValidId(podId) &&
        podId in ['pod_1', 'pod_2', 'pod_3', 'pod_4'];
    }

    // Collection 22: Old-Style Heritage Job Centre Vacancy Cards
    match /jobCentreVacancies/{vacancyId} {
      allow get: if isSignedIn() &&
        isValidId(vacancyId) &&
        (resource == null ||
          existing().status in ['open', 'filled'] ||
          existing().creatorId == request.auth.uid ||
          isAdmin());

      // Zero get()/exists() in allow list: evaluates existing() directly
      allow list: if isSignedIn() &&
        (existing().status in ['open', 'filled'] ||
          existing().creatorId == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(vacancyId) &&
        isValidJobCentreVacancy(incoming()) &&
        incoming().creatorId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (exists(/databases/$(database)/documents/publicProfiles/$(incoming().creatorId)) ||
          existsAfter(/databases/$(database)/documents/publicProfiles/$(incoming().creatorId)));

      allow update: if (
        isVerifiedUser() &&
        isValidId(vacancyId) &&
        isValidJobCentreVacancy(incoming()) &&
        incoming().creatorId == existing().creatorId &&
        incoming().referenceCode == existing().referenceCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Creator Updates Active Open or Filled Vacancy Card
          (existing().creatorId == request.auth.uid &&
            existing().status in ['open', 'filled'] &&
            incoming().status in ['open', 'filled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'jobTitle',
              'tradeCategory',
              'locationZone',
              'pacingStyle',
              'cardSummary',
              'keySteps',
              'collaborationMode',
              'collaborationOpen',
              'rewardTokens',
              'creatorName',
              'status',
              'updatedAt'
            ])) ||
          // Action 2: Creator Archives Vacancy Card (Terminal State Lock)
          (existing().creatorId == request.auth.uid &&
            existing().status in ['open', 'filled'] &&
            incoming().status == 'archived' &&
            incoming().jobTitle == existing().jobTitle &&
            incoming().tradeCategory == existing().tradeCategory &&
            incoming().locationZone == existing().locationZone &&
            incoming().pacingStyle == existing().pacingStyle &&
            incoming().cardSummary == existing().cardSummary &&
            incoming().keySteps == existing().keySteps &&
            incoming().collaborationMode == existing().collaborationMode &&
            incoming().collaborationOpen == existing().collaborationOpen &&
            incoming().rewardTokens == existing().rewardTokens &&
            incoming().creatorName == existing().creatorName &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(vacancyId) &&
        existing().creatorId == request.auth.uid) ||
        (isAdmin() && isValidId(vacancyId));

      // Subcollection 23: Multi-User Collaborator Pledges on Job Centre Cards
      match /collaborators/{memberId} {
        allow get: if isSignedIn() &&
          isValidId(vacancyId) &&
          isValidId(memberId) &&
          ((resource == null && memberId == request.auth.uid) ||
            (resource != null &&
              exists(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)) &&
              (existing().status in ['active', 'completed'] ||
                existing().memberId == request.auth.uid ||
                get(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)).data.creatorId == request.auth.uid ||
                isAdmin())));

        // Zero get()/exists() in allow list: evaluates existing() directly
        allow list: if isSignedIn() &&
          (existing().status in ['active', 'completed'] ||
            existing().memberId == request.auth.uid);

        allow create: if isVerifiedUser() &&
          isValidId(vacancyId) &&
          isValidId(memberId) &&
          memberId == request.auth.uid &&
          isValidJobCentreCollaborator(incoming()) &&
          incoming().vacancyId == vacancyId &&
          incoming().memberId == request.auth.uid &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)) &&
          get(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)).data.status == 'open' &&
          get(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)).data.collaborationOpen == true;

        allow update: if (
          isVerifiedUser() &&
          isValidId(vacancyId) &&
          isValidId(memberId) &&
          isValidJobCentreCollaborator(incoming()) &&
          incoming().vacancyId == existing().vacancyId &&
          incoming().memberId == existing().memberId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (memberId == request.auth.uid &&
              existing().memberId == request.auth.uid &&
              exists(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)) &&
              get(/databases/$(database)/documents/jobCentreVacancies/$(vacancyId)).data.status in ['open', 'filled'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'memberName',
                'collabRole',
                'pledgeNote',
                'preferredStation',
                'status',
                'updatedAt'
              ]))
          )
        );

        allow delete: if (isVerifiedUser() &&
          isValidId(vacancyId) &&
          isValidId(memberId) &&
          memberId == request.auth.uid &&
          existing().memberId == request.auth.uid) ||
          (isAdmin() && isValidId(vacancyId) && isValidId(memberId));
      }
    }

    // Collection 24: Public Beta UX Testing Feedback (Owner/Admin Isolated)
    match /uxBetaFeedback/{feedbackId} {
      allow get: if isSignedIn() &&
        isValidId(feedbackId) &&
        resource != null &&
        (existing().authorId == request.auth.uid || isAdmin());

      // Zero get()/exists() in allow list: evaluates existing() directly
      allow list: if isSignedIn() &&
        (existing().authorId == request.auth.uid ||
          (isVerifiedAdminEmail() && existing().easeScore >= 1));

      allow create: if isVerifiedUser() &&
        isValidId(feedbackId) &&
        isValidUxBetaFeedback(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(feedbackId) &&
        isValidUxBetaFeedback(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'testerHandle',
              'focusArea',
              'easeScore',
              'workedWell',
              'improvementIdea',
              'updatedAt'
            ]))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(feedbackId) &&
        existing().authorId == request.auth.uid) ||
        (isAdmin() && isValidId(feedbackId));
    }

    // Collection 25: Daily Mastery Habit Tracker & Tree-Climbing Energy Points (Owner/Admin Isolated)
    match /dailyHabitTrackers/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin()) &&
        (resource == null || existing().uid == userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidDailyHabitTracker(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidDailyHabitTracker(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (userId == request.auth.uid &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'activeDate',
              'energyPoints',
              'lifetimeEnergyEarned',
              'totalMilestonesLogged',
              'dailyStreak',
              'bestStreak',
              'completedIdsToday',
              'customHabitLabels',
              'lastMilestoneLabel',
              'updatedAt'
            ]))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().uid == request.auth.uid) ||
        (isAdmin() && isValidId(userId));
    }

    // Collection 26: Bank of Treetop Symbolic Special-Interest Stock Savings Ledger (NOT a Real Bank — Owner/Admin Isolated)
    match /bankOfTreetopLedgers/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin()) &&
        (resource == null || existing().uid == userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidBankOfTreetopLedger(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().disclaimerAccepted == true &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidBankOfTreetopLedger(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().disclaimerAccepted == true &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (userId == request.auth.uid &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'selectedBundleId',
              'customInterestGoal',
              'savedUnits',
              'lifetimeUnitsSaved',
              'bundlesRequisitioned',
              'exchequerChecksLogged',
              'disclaimerAccepted',
              'updatedAt'
            ]))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().uid == request.auth.uid) ||
        (isAdmin() && isValidId(userId));
    }
  }
}

