    // Collection 12: Ground Sign-In Kiosk Special Interest Journey Applications & Treetop Tokens
    match /treetopApplications/{applicantId} {
      allow get: if isSignedIn() &&
        isValidId(applicantId) &&
        (applicantId == request.auth.uid || isAdmin()) &&
        (resource == null || existing().applicantId == applicantId);

      // Zero get()/exists() in allow list: evaluates existing() directly
      allow list: if isSignedIn() &&
        (existing().applicantId == request.auth.uid ||
          (isVerifiedAdminEmail() && existing().status in ['pending', 'approved', 'declined']));

      allow create: if isVerifiedUser() &&
        isValidId(applicantId) &&
        isValidTreetopApplication(incoming()) &&
        incoming().applicantId == applicantId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (applicantId == request.auth.uid &&
            incoming().status == 'pending' &&
            incoming().treetopTokenGranted == false &&
            incoming().tokenCode == '' &&
            incoming().adminNote == '') ||
          isAdmin()
        );

      allow update: if (
        isVerifiedUser() &&
        isValidId(applicantId) &&
        isValidTreetopApplication(incoming()) &&
        incoming().applicantId == existing().applicantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Verified Admin Approves or Declines Application & Issues Treetop Token
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'treetopTokenGranted',
              'tokenCode',
              'adminNote',
              'updatedAt'
            ])) ||
          // Action 2: Applicant Revises Pending or Declined Journey Note (Still Strictly Unapproved)
          (applicantId == request.auth.uid &&
            existing().applicantId == request.auth.uid &&
            existing().status in ['pending', 'declined'] &&
            incoming().status == 'pending' &&
            incoming().treetopTokenGranted == false &&
            incoming().tokenCode == '' &&
            incoming().adminNote == existing().adminNote &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'specialInterestJourney',
              'preferredTradeTrack',
              'supervisionContext',
              'status',
              'updatedAt'
            ]))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(applicantId) &&
        applicantId == request.auth.uid &&
        existing().applicantId == request.auth.uid) ||
        (isAdmin() && isValidId(applicantId));
    }

