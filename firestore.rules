rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// 1. Collection: publicProfiles/{userId}
//    Fields: uid (string, immutable), username (string, 2..40), createdAt (timestamp, immutable), updatedAt (timestamp)
// 2. Collection: communityPosts/{postId}
//    Fields: authorId (string, immutable), username (string, 2..40), category (enum), title (string, 3..100),
//            message (string, 10..1500), visibility ('published'|'archived'), createdAt (timestamp, immutable), updatedAt (timestamp)
// 3. Collection: canopyStudios/{userId}
//    Fields: uid (string, immutable), studioName (string, 2..48), tradeFocus (enum), floorStyle (enum),
//            trimAccent (enum), safetyGateClosed (bool), furnishedItems (list<=6), createdAt (timestamp, immutable), updatedAt (timestamp)
// 4. Collection: journalEntries/{entryId} (Owner-Only Private)
//    Fields: uid (string, immutable), title (string, 1..120), content (string, 1..4000), entryType (enum),
//            createdAt (timestamp, immutable), updatedAt (timestamp)
// 5. Collection: treeProgress/{userId} (Owner/Admin Isolated)
//    Fields: uid (string, immutable), tryingTokens (int), gatheringTokens (int), treehouseTokens (int),
//            ownedFurnishings (list<=6), sharesCompleted (int), welcomeCheckedIn (bool),
//            dailyStreak (opt int), bestStreak (opt int), lastStreakDate (opt YYYY-MM-DD),
//            createdAt (timestamp, immutable), updatedAt (timestamp)
// 6. Collection: toolsOfTrade/{toolId}
//    Fields: ownerId (string, immutable), username (string, 2..40), toolName (string, 2..60), tradeCategory (enum),
//            visualKind (enum), showAndTellStory (string, 10..600), isSharedShowAndTell (bool),
//            createdAt (timestamp, immutable), updatedAt (timestamp)
// 7. Collection: storeListings/{listingId}
//    Fields: sellerId (string, immutable), sellerName (string, 2..40), itemKind (enum), title (string, 3..80),
//            craftNote (string, 8..400), priceTokens (int, 1..50), status ('available'|'sold'|'cancelled'),
//            buyerId (string), proceedsClaimed (bool), createdAt (timestamp, immutable), updatedAt (timestamp)
// 8. Collection: serviceProviders/{providerId}
//    Fields: providerId (string, immutable), displayName (string, 2..50), providerRole (enum),
//            specialtySummary (string, 10..500), neuroAccommodations (string, 6..300), sessionMode (enum),
//            availabilityStatus ('available'|'paused'|'archived'), createdAt (timestamp, immutable), updatedAt (timestamp)
// 9. Collection: artisanItems/{itemId}
//    Fields: makerId (string, immutable), makerName (string, 2..40), title (string, 3..80), category (enum),
//            materialsAndDimensions (string, 6..240), story (string, 10..500), priceCents (int, 300..250000),
//            stockCount (int, 0..100), status ('active'|'sold_out'|'archived'), createdAt (timestamp, immutable), updatedAt (timestamp)
// 10. Collection: privacyConsents/{userId} (Owner-Only UK/EU GDPR Consent)
//     Fields: uid (string, immutable), policyVersion (string, 2..32), localDeviceStorage (bool),
//             cloudProgressSync (bool), privateJournalCloudSync (bool), communityAttributionConsent (bool),
//             liveCollabPresenceConsent (bool), usePseudonym (bool), createdAt (timestamp, immutable), updatedAt (timestamp)
// 11. Collection: admins/{adminId}
//     Fields: uid (string, immutable), handle (string, 2..40), createdAt (timestamp, immutable), updatedAt (timestamp)
// 12. Collection: treetopApplications/{applicantId}
//     Fields: applicantId (string, immutable), displayName (string, 2..40), specialInterestJourney (string, 15..1200),
//             preferredTradeTrack (enum), supervisionContext (enum), status ('pending'|'approved'|'declined'),
//             treetopTokenGranted (bool), tokenCode (string), adminNote (string), createdAt (timestamp, immutable), updatedAt (timestamp)
// 13. Collection: pgCertNotes/{noteId}
//     Fields: authorId (string, immutable), studentHandle (string, 2..50), moduleTheme (enum), title (string, 4..120),
//             studyReflection (string, 20..3000), practiceTakeaway (string, 10..600), visibility ('published'|'archived'),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 14. Collection: canopyWorkshops/{workshopId}
//     Fields: hostId (string, immutable), hostName (string, 2..40), title (string, 4..90), tradeCategory (enum),
//             specialInterestFocus (string, 6..280), rotaSlotLabel (string, 4..80), sensoryPacingNote (string, 6..240),
//             overflowPlatform (enum), overflowSummary (string, 6..300), maxParticipants (int, 2..30),
//             status ('scheduled'|'completed'|'cancelled'), createdAt (timestamp, immutable), updatedAt (timestamp)
// 15. Subcollection: canopyWorkshops/{workshopId}/registrations/{attendeeId}
//     Fields: workshopId (string, immutable), attendeeId (string, immutable), attendeeName (string, 2..40),
//             wantsSocialOverflow (bool), adultApprovalType (enum), adultApprovalConfirmed (bool),
//             appropriatenessConfirmed (bool), safeguardingNote (string, 0..240), status ('registered'|'cancelled'),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 16. Subcollection: canopyWorkshops/{workshopId}/overflowAccess/{detailId}
//     Fields: workshopId (string, immutable), hostId (string, immutable), platformLabel (string, 2..60),
//             joinInstructionsAndHandle (string, 6..400), moderationRules (string, 6..300),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 17. Collection: interestPathways/{pathwayId} (Owner/Admin Isolated)
//     Fields: uid (string, immutable), entrantHandle (string, 2..40), specialInterest (string, 2..120),
//             potentialJobRole (string, 2..120), tradeTrack (enum), comfortableNextStep (string, 0..360),
//             readinessStage (enum), createdAt (timestamp, immutable), updatedAt (timestamp)
// 18. Collection: craftedBottles/{bottleId}
//     Fields: makerId (string, immutable), makerName (string, 2..40), productTitle (string, 3..80),
//             labelHeadline (string, 2..40), labelBatchNote (string, 2..80), barkOriginAndProcess (string, 10..500),
//             bottleSizeMl (5|10|15|30), saleVenue ('welcome_area'|'canopy'|'both'), pricePence (int, 300..50000),
//             priceTokens (int, 1..50), stockCount (int, 0..50), status ('on_sale'|'sold_out'|'archived'),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 19. Collection: canopyPaypalItems/{itemId}
//     Fields: sellerId (string, immutable), sellerName (string, 2..40), title (string, 3..80), tradeCategory (enum),
//             materialsSpec (string, 5..200), craftStory (string, 10..600), sellerBenchTag (string, 0..50),
//             priceCents (int, 300..250000), stockCount (int, 0..100), status ('active'|'sold_out'|'archived'),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 20. Collection: shoeCharacters/{userId} (Owner/Admin Isolated)
//     Fields: uid (string, immutable), shoeKind (enum), colorway (enum), characterNickname (string, 2..36),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 21. Collection: chillPodOccupancy/{podId} (1 Person Max Per Pod: pod_1..pod_4)
//     Fields: podId (enum, immutable), podLabel (string, 3..40), occupantId (string, 0..128), occupantName (string, 0..40),
//             occupancyStatus ('vacant'|'occupied'), fanEnabled (bool), heaterEnabled (bool, mutually exclusive with fanEnabled),
//             lightsOffCalm (bool), flotationEnabled (bool), quiltType ('none'|'vegan'|'natural_duck_feather'),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
// 22. Collection: jobCentreVacancies/{vacancyId}
//     Fields: referenceCode (JC-*, immutable), jobTitle (string, 3..90), tradeCategory (enum), locationZone (enum),
//             pacingStyle (enum), cardSummary (string, 10..700), keySteps (string, 6..500), collaborationMode (enum),
//             collaborationOpen (bool), rewardTokens (int, 1..15), creatorId (string, immutable), creatorName (string, 2..40),
//             status ('open'|'filled'|'archived'), createdAt (timestamp, immutable), updatedAt (timestamp)
// 23. Subcollection: jobCentreVacancies/{vacancyId}/collaborators/{memberId}
//     Fields: vacancyId (string, immutable), memberId (string, immutable), memberName (string, 2..40),
//             collabRole (enum), pledgeNote (string, 4..280), preferredStation (enum),
//             status ('active'|'completed'|'stepped_back'), createdAt (timestamp, immutable), updatedAt (timestamp)
// 24. Collection: uxBetaFeedback/{feedbackId} (Owner/Admin Isolated)
//     Fields: authorId (string, immutable), testerHandle (string, 2..40), focusArea (enum), easeScore (int, 1..5),
//             workedWell (string, 4..600), improvementIdea (string, 0..600), createdAt (timestamp, immutable), updatedAt (timestamp)
// 25. Collection: dailyHabitTrackers/{userId} (Owner/Admin Isolated)
//     Fields: uid (string, immutable), activeDate (YYYY-MM-DD), energyPoints (int, 0..99999),
//             lifetimeEnergyEarned (int, 0..999999), totalMilestonesLogged (int, 0..99999),
//             dailyStreak (int, 0..99999), bestStreak (int, 0..99999),
//             completedIdsToday (list<=10), customHabitLabels (list<=5), lastMilestoneLabel (string, 0..80),
//             createdAt (timestamp, immutable), updatedAt (timestamp)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar & Phase 4.1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions & Hardened Global Primitives
    // ===============================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Admin check (Enforces email_verified == true to defeat Email Spoofing; zero DB reads)
    function isVerifiedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'treetophomeschool@gmail.com';
    }

    // Full Admin check for single-document operations (get, create, update, delete)
    function isAdmin() {
      return isVerifiedAdminEmail() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Master Treetop Token Entry Gate (Single-doc read/write check; never used in allow list)
    function hasApprovedTreetopToken() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/treetopApplications/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/treetopApplications/$(request.auth.uid)).data.status == 'approved' &&
        get(/databases/$(database)/documents/treetopApplications/$(request.auth.uid)).data.treetopTokenGranted == true
      );
    }

    function isValidFurnishingList(items) {
      return items is list &&
        items.size() <= 6 &&
        (items.size() == 0 || (items[0] is string && items[0].size() >= 1 && items[0].size() <= 32)) &&
        items.hasOnly([
          'brass_hanging_lantern',
          'amber_floor_lantern',
          'starlight_garland',
          'cedar_reading_lamp',
          'woven_sanctuary_rug',
          'fern_planter_box'
        ]);
    }

    // Validation Blueprint 1: PublicProfile
    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'username', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.uid == request.auth.uid || isVerifiedAdminEmail()) &&
        data.username is string &&
        data.username.size() >= 2 &&
        data.username.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 2: CommunityPost
    function isValidCommunityPost(data) {
      return data.keys().hasAll([
          'authorId',
          'username',
          'category',
          'title',
          'message',
          'visibility',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId',
          'username',
          'category',
          'title',
          'message',
          'visibility',
          'createdAt',
          'updatedAt'
        ]) &&
        data.authorId is string &&
        data.authorId.size() >= 1 &&
        data.authorId.size() <= 128 &&
        data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.authorId == request.auth.uid || isVerifiedAdminEmail()) &&
        data.username is string &&
        data.username.size() >= 2 &&
        data.username.size() <= 40 &&
        data.category is string &&
        data.category.size() >= 1 &&
        data.category.size() <= 32 &&
        data.category in [
          'Job Opportunity',
          'Collaboration Request',
          'Resource Share',
          'General Advice'
        ] &&
        data.title is string &&
        data.title.size() >= 3 &&
        data.title.size() <= 100 &&
        data.message is string &&
        data.message.size() >= 10 &&
        data.message.size() <= 1500 &&
        data.visibility is string &&
        data.visibility.size() >= 1 &&
        data.visibility.size() <= 16 &&
        data.visibility in ['published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 3: CanopyStudio
    function isValidCanopyStudio(data) {
      return data.keys().hasAll([
          'uid',
          'studioName',
          'tradeFocus',
          'floorStyle',
          'trimAccent',
          'safetyGateClosed',
          'furnishedItems',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'studioName',
          'tradeFocus',
          'floorStyle',
          'trimAccent',
          'safetyGateClosed',
          'furnishedItems',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.uid == request.auth.uid || isVerifiedAdminEmail()) &&
        data.studioName is string &&
        data.studioName.size() >= 2 &&
        data.studioName.size() <= 48 &&
        data.tradeFocus is string &&
        data.tradeFocus.size() >= 1 &&
        data.tradeFocus.size() <= 40 &&
        data.tradeFocus in [
          'Woodcraft & Joinery',
          'Metalwork & Lanterns',
          'Textiles & Weaving',
          'Repair & Maker Tools',
          'Community Outreach'
        ] &&
        data.floorStyle is string &&
        data.floorStyle.size() >= 1 &&
        data.floorStyle.size() <= 32 &&
        data.floorStyle in [
          'interlocking_oak',
          'nonslip_slate',
          'cork_sanctuary',
          'herringbone_cedar'
        ] &&
        data.trimAccent is string &&
        data.trimAccent.size() >= 1 &&
        data.trimAccent.size() <= 24 &&
        data.trimAccent in [
          'warm_brass',
          'forged_iron',
          'forest_sage',
          'terracotta_clay'
        ] &&
        data.safetyGateClosed is bool &&
        isValidFurnishingList(data.furnishedItems) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 4: JournalEntry
    function isValidJournalEntry(data) {
      return data.keys().hasAll([
          'uid',
          'title',
          'content',
          'entryType',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'title',
          'content',
          'entryType',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.content is string &&
        data.content.size() >= 1 &&
        data.content.size() <= 4000 &&
        data.entryType is string &&
        data.entryType.size() >= 1 &&
        data.entryType.size() <= 40 &&
        data.entryType in [
          'Special Interest Idea',
          'Working Paper & Notes',
          'Job Step Reflection',
          'Collab & Trade Plan'
        ] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 5: TreeProgress
    function isValidTreeProgress(data) {
      return data.keys().hasAll([
          'uid',
          'tryingTokens',
          'gatheringTokens',
          'treehouseTokens',
          'ownedFurnishings',
          'sharesCompleted',
          'welcomeCheckedIn',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'tryingTokens',
          'gatheringTokens',
          'treehouseTokens',
          'ownedFurnishings',
          'sharesCompleted',
          'welcomeCheckedIn',
          'dailyStreak',
          'bestStreak',
          'lastStreakDate',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.uid == request.auth.uid || isVerifiedAdminEmail()) &&
        data.tryingTokens is int &&
        data.tryingTokens >= 0 &&
        data.tryingTokens <= 99999 &&
        data.gatheringTokens is int &&
        data.gatheringTokens >= 0 &&
        data.gatheringTokens <= 99999 &&
        data.treehouseTokens is int &&
        data.treehouseTokens >= 0 &&
        data.treehouseTokens <= 99999 &&
        isValidFurnishingList(data.ownedFurnishings) &&
        data.sharesCompleted is int &&
        data.sharesCompleted >= 0 &&
        data.sharesCompleted <= 99999 &&
        data.welcomeCheckedIn is bool &&
        (!('dailyStreak' in data) || (data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 99999)) &&
        (!('bestStreak' in data) || (data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 99999)) &&
        (!('lastStreakDate' in data) || (
          data.lastStreakDate is string &&
          data.lastStreakDate.size() <= 10 &&
          (data.lastStreakDate == '' || data.lastStreakDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 6: ToolOfTrade
    function isValidToolOfTrade(data) {
      return data.keys().hasAll([
          'ownerId',
          'username',
          'toolName',
          'tradeCategory',
          'visualKind',
          'showAndTellStory',
          'isSharedShowAndTell',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'username',
          'toolName',
          'tradeCategory',
          'visualKind',
          'showAndTellStory',
          'isSharedShowAndTell',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.ownerId == request.auth.uid || isVerifiedAdminEmail()) &&
        data.username is string &&
        data.username.size() >= 2 &&
        data.username.size() <= 40 &&
        data.toolName is string &&
        data.toolName.size() >= 2 &&
        data.toolName.size() <= 60 &&
        data.tradeCategory is string &&
        data.tradeCategory.size() >= 1 &&
        data.tradeCategory.size() <= 40 &&
        data.tradeCategory in [
          'Woodcraft & Joinery',
          'Metalwork & Lanterns',
          'Textiles & Weaving',
          'Repair & Maker Tools',
          'Community Outreach',
          'Botanical & Essential Oils'
        ] &&
        data.visualKind is string &&
        data.visualKind.size() >= 1 &&
        data.visualKind.size() <= 32 &&
        data.visualKind in [
          'joinery_plane',
          'precision_calipers',
          'loom_shuttle',
          'soldering_iron_kit',
          'botanical_press',
          'outreach_compass_kit',
          'agarwood_alembic_still',
          'amber_bottling_kit'
        ] &&
        data.showAndTellStory is string &&
        data.showAndTellStory.size() >= 10 &&
        data.showAndTellStory.size() <= 600 &&
        data.isSharedShowAndTell is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 7: StoreListing
    function isValidStoreListing(data) {
      return data.keys().hasAll([
          'sellerId',
          'sellerName',
          'itemKind',
          'title',
          'craftNote',
          'priceTokens',
          'status',
          'buyerId',
          'proceedsClaimed',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sellerId',
          'sellerName',
          'itemKind',
          'title',
          'craftNote',
          'priceTokens',
          'status',
          'buyerId',
          'proceedsClaimed',
          'createdAt',
          'updatedAt'
        ]) &&
        data.sellerId is string &&
        data.sellerId.size() >= 1 &&
        data.sellerId.size() <= 128 &&
        data.sellerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.sellerName is string &&
        data.sellerName.size() >= 2 &&
        data.sellerName.size() <= 40 &&
        data.itemKind is string &&
        data.itemKind.size() >= 1 &&
        data.itemKind.size() <= 32 &&
        data.itemKind in [
          'brass_hanging_lantern',
          'amber_floor_lantern',
          'starlight_garland',
          'cedar_reading_lamp',
          'woven_sanctuary_rug',
          'fern_planter_box'
        ] &&
        data.title is string &&
        data.title.size() >= 3 &&
        data.title.size() <= 80 &&
        data.craftNote is string &&
        data.craftNote.size() >= 8 &&
        data.craftNote.size() <= 400 &&
        data.priceTokens is int &&
        data.priceTokens >= 1 &&
        data.priceTokens <= 50 &&
        data.status is string &&
        data.status.size() >= 1 &&
        data.status.size() <= 16 &&
        data.status in ['available', 'sold', 'cancelled'] &&
        data.buyerId is string &&
        data.buyerId.size() <= 128 &&
        (
          (data.status in ['available', 'cancelled'] &&
            data.buyerId == '' &&
            data.proceedsClaimed == false &&
            data.sellerId == request.auth.uid) ||
          (data.status == 'sold' &&
            data.buyerId.size() >= 1 &&
            data.buyerId.matches('^[a-zA-Z0-9_\\-]+$') &&
            data.buyerId != data.sellerId &&
            (data.sellerId == request.auth.uid || data.buyerId == request.auth.uid || isVerifiedAdminEmail()))
        ) &&
        data.proceedsClaimed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 8: ServiceProvider
    function isValidServiceProvider(data) {
      return data.keys().hasAll([
          'providerId',
          'displayName',
          'providerRole',
          'specialtySummary',
          'neuroAccommodations',
          'sessionMode',
          'availabilityStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'providerId',
          'displayName',
          'providerRole',
          'specialtySummary',
          'neuroAccommodations',
          'sessionMode',
          'availabilityStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.providerId is string &&
        data.providerId.size() >= 1 &&
        data.providerId.size() <= 128 &&
        data.providerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.providerId == request.auth.uid || isVerifiedAdminEmail()) &&
        data.displayName is string &&
        data.displayName.size() >= 2 &&
        data.displayName.size() <= 50 &&
        data.providerRole is string &&
        data.providerRole.size() >= 1 &&
        data.providerRole.size() <= 64 &&
        data.providerRole in [
          'Pre-Crisis Intervention Counsellor',
          'Crisis Coaching Specialist',
          'Neurobiologically-Aware Skills & Trade Trainer'
        ] &&
        data.specialtySummary is string &&
        data.specialtySummary.size() >= 10 &&
        data.specialtySummary.size() <= 500 &&
