              get(/databases/$(database)/documents/canopyWorkshops/$(workshopId)/registrations/$(request.auth.uid)).data.status == 'registered' &&
              get(/databases/$(database)/documents/canopyWorkshops/$(workshopId)/registrations/$(request.auth.uid)).data.wantsSocialOverflow == true &&
              get(/databases/$(database)/documents/canopyWorkshops/$(workshopId)/registrations/$(request.auth.uid)).data.adultApprovalConfirmed == true &&
              get(/databases/$(database)/documents/canopyWorkshops/$(workshopId)/registrations/$(request.auth.uid)).data.appropriatenessConfirmed == true)
          );

        allow list: if false;

        allow create: if isVerifiedUser() &&
