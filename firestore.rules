        data.podId in ['pod_1', 'pod_2', 'pod_3', 'pod_4'] &&
        data.podLabel is string &&
        data.podLabel.size() >= 3 &&
        data.podLabel.size() <= 40 &&
        data.occupantId is string &&
        data.occupantId.size() <= 128 &&
        (data.occupantId == '' || data.occupantId.matches('^[a-zA-Z0-9_\\-]+$')) &&
        data.occupantName is string &&
        data.occupantName.size() <= 40 &&
        data.occupancyStatus is string &&
        data.occupancyStatus.size() >= 1 &&
        data.occupancyStatus.size() <= 16 &&
        data.occupancyStatus in ['vacant', 'occupied'] &&
        data.fanEnabled is bool &&
        data.heaterEnabled is bool &&
        !(data.fanEnabled == true && data.heaterEnabled == true) &&
        data.lightsOffCalm is bool &&
        data.flotationEnabled is bool &&
        data.quiltType is string &&
        data.quiltType.size() >= 1 &&
        data.quiltType.size() <= 24 &&
        data.quiltType in ['none', 'vegan', 'natural_duck_feather'] &&
        (
          (data.occupancyStatus == 'vacant' &&
            data.occupantId == '' &&
            data.occupantName == '' &&
            data.fanEnabled == false &&
            data.heaterEnabled == false &&
            data.lightsOffCalm == false &&
            data.flotationEnabled == false &&
            data.quiltType == 'none') ||
          (data.occupancyStatus == 'occupied' &&
            data.occupantId.size() >= 1 &&
            data.occupantName.size() >= 2)
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 22: JobCentreVacancy (Heritage Pegged Vacancy Card Rack)
    function isValidJobCentreVacancy(data) {
      return data.keys().hasAll([
          'referenceCode',
          'jobTitle',
          'tradeCategory',
          'locationZone',
          'pacingStyle',
          'cardSummary',
          'keySteps',
          'collaborationMode',
          'collaborationOpen',
          'rewardTokens',
          'creatorId',
          'creatorName',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'referenceCode',
          'jobTitle',
          'tradeCategory',
          'locationZone',
          'pacingStyle',
          'cardSummary',
          'keySteps',
          'collaborationMode',
          'collaborationOpen',
          'rewardTokens',
          'creatorId',
          'creatorName',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.referenceCode is string &&
        data.referenceCode.size() >= 4 &&
        data.referenceCode.size() <= 16 &&
        data.referenceCode.matches('^JC-[A-Z0-9\\-]+$') &&
        data.jobTitle is string &&
        data.jobTitle.size() >= 3 &&
        data.jobTitle.size() <= 90 &&
        data.tradeCategory is string &&
        data.tradeCategory.size() >= 1 &&
        data.tradeCategory.size() <= 48 &&
        data.tradeCategory in [
          'Woodcraft & Joinery',
          'Metalwork & Lanterns',
          'Textiles & Weaving',
          'Repair & Maker Tools',
          'Digital & Systems Craft',
          'Botanical & Community Outreach',
          'Botanical & Essential Oils'
        ] &&
        data.locationZone is string &&
        data.locationZone.size() >= 1 &&
        data.locationZone.size() <= 48 &&
        data.locationZone in [
          '0m Courtyard Workbench',
          '12m Ascent Relay',
          '33m Canopy Workshop',
          '33m Mezzanine Library & Refreshments',
          'Community Outreach Rota'
        ] &&
        data.pacingStyle is string &&
        data.pacingStyle.size() >= 1 &&
        data.pacingStyle.size() <= 32 &&
        data.pacingStyle in [
          'Self-Paced Solo',
          'Paired Quiet Bench',
          'Small Collab Crew (2-4)',
          'Flexible Drop-In'
        ] &&
        data.cardSummary is string &&
        data.cardSummary.size() >= 10 &&
        data.cardSummary.size() <= 700 &&
        data.keySteps is string &&
        data.keySteps.size() >= 6 &&
        data.keySteps.size() <= 500 &&
        data.collaborationMode is string &&
        data.collaborationMode.size() >= 1 &&
        data.collaborationMode.size() <= 40 &&
        data.collaborationMode in [
          'Solo or Optional Buddy',
          'Open Team-Up & Skill Swap',
          'Mentor + Apprentice Pair',
          'Shared Outreach Crew'
        ] &&
        data.collaborationOpen is bool &&
        data.rewardTokens is int &&
        data.rewardTokens >= 1 &&
        data.rewardTokens <= 15 &&
        data.creatorId is string &&
        data.creatorId.size() >= 1 &&
        data.creatorId.size() <= 128 &&
        data.creatorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.creatorId == request.auth.uid || isVerifiedAdminEmail()) &&
        data.creatorName is string &&
        data.creatorName.size() >= 2 &&
        data.creatorName.size() <= 40 &&
        data.status is string &&
        data.status.size() >= 1 &&
        data.status.size() <= 16 &&
        data.status in ['open', 'filled', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 23: JobCentreCollaborator (Multi-User Team-Up Pledge on Vacancy Card)
    function isValidJobCentreCollaborator(data) {
      return data.keys().hasAll([
          'vacancyId',
          'memberId',
          'memberName',
          'collabRole',
          'pledgeNote',
          'preferredStation',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'vacancyId',
          'memberId',
          'memberName',
          'collabRole',
          'pledgeNote',
          'preferredStation',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.vacancyId is string &&
        data.vacancyId.size() >= 1 &&
        data.vacancyId.size() <= 128 &&
        data.vacancyId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.memberId is string &&
        data.memberId.size() >= 1 &&
        data.memberId.size() <= 128 &&
        data.memberId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.memberId == request.auth.uid || isVerifiedAdminEmail()) &&
        data.memberName is string &&
        data.memberName.size() >= 2 &&
        data.memberName.size() <= 40 &&
        data.collabRole is string &&
        data.collabRole.size() >= 1 &&
        data.collabRole.size() <= 32 &&
        data.collabRole in [
          'Lead Maker',
          'Co-Maker Buddy',
          'Quiet Prep & Sorting',
          'Finishing & Labelling',
          'Outreach Helper'
        ] &&
        data.pledgeNote is string &&
        data.pledgeNote.size() >= 4 &&
        data.pledgeNote.size() <= 280 &&
        data.preferredStation is string &&
        data.preferredStation.size() >= 1 &&
        data.preferredStation.size() <= 32 &&
        data.preferredStation in [
          'Ground Courtyard',
          'Canopy Workbench',
          'Mezzanine Library Desk',
          'Async Written Notes'
        ] &&
        data.status is string &&
        data.status.size() >= 1 &&
        data.status.size() <= 16 &&
        data.status in ['active', 'completed', 'stepped_back'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint 24: UxBetaFeedback (Public Beta UX Testing Notes)
    function isValidUxBetaFeedback(data) {
      return data.keys().hasAll([
          'authorId',
          'testerHandle',
          'focusArea',
          'easeScore',
          'workedWell',
          'improvementIdea',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorId',
          'testerHandle',
          'focusArea',
          'easeScore',
          'workedWell',
          'improvementIdea',
          'createdAt',
          'updatedAt'
        ]) &&
        data.authorId is string &&
        data.authorId.size() >= 1 &&
        data.authorId.size() <= 128 &&
        data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.authorId == request.auth.uid || isVerifiedAdminEmail()) &&
        data.testerHandle is string &&
        data.testerHandle.size() >= 2 &&
        data.testerHandle.size() <= 40 &&
        data.focusArea is string &&
        data.focusArea.size() >= 1 &&
        data.focusArea.size() <= 48 &&
        data.focusArea in [
          'Overall Navigation & Readability',
          'Old-Style Job Centre & Collaboration',
          'Mezzanine Library & Refreshments',
          'Private Sensory Chill Pods',
          'Entry Kiosk & Canopy Lift'
        ] &&
        data.easeScore is int &&
        data.easeScore >= 1 &&
        data.easeScore <= 5 &&
        data.workedWell is string &&
        data.workedWell.size() >= 4 &&
        data.workedWell.size() <= 600 &&
        data.improvementIdea is string &&
        data.improvementIdea.size() <= 600 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHabitCompletedList(items) {
      return items is list &&
        items.size() <= 10 &&
        (items.size() == 0 || (items[0] is string && items[0].size() >= 1 && items[0].size() <= 32)) &&
        items.hasOnly([
          'focus_15m',
          'community_outreach',
          'job_slip_step',
          'skill_practice',
          'sensory_pacing',
          'custom_1',
          'custom_2',
          'custom_3',
          'custom_4',
          'custom_5'
        ]);
    }

    function isValidCustomHabitLabels(items) {
      return items is list &&
        items.size() <= 5 &&
        (items.size() < 1 || (items[0] is string && items[0].size() >= 2 && items[0].size() <= 60)) &&
        (items.size() < 2 || (items[1] is string && items[1].size() >= 2 && items[1].size() <= 60)) &&
        (items.size() < 3 || (items[2] is string && items[2].size() >= 2 && items[2].size() <= 60)) &&
        (items.size() < 4 || (items[3] is string && items[3].size() >= 2 && items[3].size() <= 60)) &&
        (items.size() < 5 || (items[4] is string && items[4].size() >= 2 && items[4].size() <= 60));
    }

    // Validation Blueprint 25: DailyHabitTracker (PassiveUserDashboard Daily Mastery Habits & Tree-Climbing Energy Points)
    function isValidDailyHabitTracker(data) {
      return data.keys().hasAll([
          'uid',
          'activeDate',
          'energyPoints',
          'lifetimeEnergyEarned',
          'totalMilestonesLogged',
          'dailyStreak',
          'bestStreak',
          'completedIdsToday',
          'customHabitLabels',
          'lastMilestoneLabel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'activeDate',
          'energyPoints',
          'lifetimeEnergyEarned',
          'totalMilestonesLogged',
          'dailyStreak',
          'bestStreak',
          'completedIdsToday',
          'customHabitLabels',
          'lastMilestoneLabel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.uid == request.auth.uid || isVerifiedAdminEmail()) &&
        data.activeDate is string &&
        data.activeDate.size() == 10 &&
        data.activeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.energyPoints is int &&
        data.energyPoints >= 0 &&
        data.energyPoints <= 99999 &&
        data.lifetimeEnergyEarned is int &&
        data.lifetimeEnergyEarned >= 0 &&
        data.lifetimeEnergyEarned <= 999999 &&
        data.lifetimeEnergyEarned >= data.energyPoints &&
        data.totalMilestonesLogged is int &&
        data.totalMilestonesLogged >= 0 &&
        data.totalMilestonesLogged <= 99999 &&
        data.dailyStreak is int &&
        data.dailyStreak >= 0 &&
        data.dailyStreak <= 99999 &&
        data.bestStreak is int &&
        data.bestStreak >= 0 &&
        data.bestStreak <= 99999 &&
        data.bestStreak >= data.dailyStreak &&
        isValidHabitCompletedList(data.completedIdsToday) &&
        isValidCustomHabitLabels(data.customHabitLabels) &&
        data.lastMilestoneLabel is string &&
        data.lastMilestoneLabel.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBankOfTreetopLedger(data) {
      return data.keys().hasAll([
          'uid',
          'selectedBundleId',
          'customInterestGoal',
          'savedUnits',
          'lifetimeUnitsSaved',
          'bundlesRequisitioned',
          'exchequerChecksLogged',
          'disclaimerAccepted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'selectedBundleId',
          'customInterestGoal',
          'savedUnits',
          'lifetimeUnitsSaved',
          'bundlesRequisitioned',
          'exchequerChecksLogged',
          'disclaimerAccepted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.uid == request.auth.uid || isVerifiedAdminEmail()) &&
        data.selectedBundleId is string &&
        data.selectedBundleId.size() >= 1 &&
        data.selectedBundleId.size() <= 40 &&
        data.selectedBundleId in [
          'stock_cedar_joinery',
          'stock_agarwood_vials',
          'stock_drazella_publishing',
          'stock_brass_lanterns',
          'stock_plant_dyed_wool',
          'stock_custom_interest'
        ] &&
        data.customInterestGoal is string &&
        data.customInterestGoal.size() <= 90 &&
        data.savedUnits is int &&
        data.savedUnits >= 0 &&
        data.savedUnits <= 9999 &&
        data.lifetimeUnitsSaved is int &&
        data.lifetimeUnitsSaved >= 0 &&
        data.lifetimeUnitsSaved <= 99999 &&
        data.lifetimeUnitsSaved >= data.savedUnits &&
        data.bundlesRequisitioned is int &&
        data.bundlesRequisitioned >= 0 &&
        data.bundlesRequisitioned <= 9999 &&
        data.exchequerChecksLogged is int &&
        data.exchequerChecksLogged >= 0 &&
        data.exchequerChecksLogged <= 9999 &&
        data.disclaimerAccepted is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Connectivity probe path for boot-time getDocFromServer check
    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // Collection 1: Public Non-PII Member Profiles
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (isOwner(userId) || (resource != null && existing().uid == userId));
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        uidUnchanged() &&
        hasRequiredFields(['uid', 'username', 'createdAt', 'updatedAt']) &&
        hasOnlyAllowedFields(['uid', 'username', 'createdAt', 'updatedAt']) &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming()) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['username', 'updatedAt']))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        existing().uid == request.auth.uid;
    }

    // Collection 2: Ground Floor Job & Collab Board Posts
    match /communityPosts/{postId} {
      allow get: if isSignedIn() &&
        isValidId(postId) &&
        resource != null &&
        (existing().visibility == 'published' || existing().authorId == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
        existing().visibility == 'published';

      allow create: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidCommunityPost(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().visibility == 'published' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (exists(/databases/$(database)/documents/publicProfiles/$(incoming().authorId)) ||
          existsAfter(/databases/$(database)/documents/publicProfiles/$(incoming().authorId)));

      allow update: if (
        isVerifiedUser() &&
        isValidId(postId) &&
        isValidCommunityPost(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().authorId == request.auth.uid &&
            existing().visibility == 'published' &&
            incoming().visibility == 'published' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username',
              'category',
              'title',
              'message',
              'updatedAt'
            ])) ||
          (existing().authorId == request.auth.uid &&
            existing().visibility == 'published' &&
            incoming().visibility == 'archived' &&
            incoming().username == existing().username &&
            incoming().category == existing().category &&
            incoming().title == existing().title &&
            incoming().message == existing().message &&
            incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'updatedAt']))
        )
      );

      allow delete: if (isVerifiedUser() &&
        isValidId(postId) &&
        existing().authorId == request.auth.uid) ||
        (isAdmin() && isValidId(postId));
    }

    // Collection 3: Canopy Summit Personal Trade Area, Secure Flooring & Placed Lanterns
    match /canopyStudios/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        (resource == null || existing().uid == request.auth.uid);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidCanopyStudio(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidCanopyStudio(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (userId == request.auth.uid &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studioName',
              'tradeFocus',
              'floorStyle',
              'trimAccent',
              'safetyGateClosed',
              'furnishedItems',
              'updatedAt'
            ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().uid == request.auth.uid;
    }

    // Collection 4: Private Chronological Personal Journal Entries
    match /journalEntries/{entryId} {
      allow get: if isSignedIn() &&
        isValidId(entryId) &&
        resource != null &&
        existing().uid == request.auth.uid;

      allow list: if isSignedIn() &&
        existing().uid == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidJournalEntry(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(entryId) &&
        isValidJournalEntry(incoming()) && (
          (existing().uid == request.auth.uid &&
            incoming().uid == existing().uid &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'content',
              'entryType',
              'updatedAt'
            ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(entryId) &&
        existing().uid == request.auth.uid;
    }

    // Collection 5: Member Welcome Area, Trying/Gathering/Treehouse Tokens, Owned Furnishings & Daily Streak
    match /treeProgress/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin()) &&
        (resource == null || existing().uid == userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidTreeProgress(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidTreeProgress(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (userId == request.auth.uid &&
            existing().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'tryingTokens',
              'gatheringTokens',
              'treehouseTokens',
              'ownedFurnishings',
              'sharesCompleted',
              'welcomeCheckedIn',
              'dailyStreak',
              'bestStreak',
              'lastStreakDate',
              'updatedAt'
            ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().uid == request.auth.uid;
    }

    // Collection 6: Canopy Tools of the Trade Show & Tell Locker
    match /toolsOfTrade/{toolId} {
      allow get: if isSignedIn() &&
        isValidId(toolId) &&
        resource != null &&
        (existing().ownerId == request.auth.uid || existing().isSharedShowAndTell == true || isAdmin());

      allow list: if isSignedIn() &&
        (existing().ownerId == request.auth.uid || existing().isSharedShowAndTell == true);

      allow create: if isVerifiedUser() &&
        isValidId(toolId) &&
        isValidToolOfTrade(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (exists(/databases/$(database)/documents/publicProfiles/$(incoming().ownerId)) ||
          existsAfter(/databases/$(database)/documents/publicProfiles/$(incoming().ownerId)));

      allow update: if (
        isVerifiedUser() &&
        isValidId(toolId) &&
        isValidToolOfTrade(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username',
              'toolName',
              'tradeCategory',
              'visualKind',
              'showAndTellStory',
              'isSharedShowAndTell',
              'updatedAt'
            ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(toolId) &&
        existing().ownerId == request.auth.uid;
    }

    // Collection 7: Player-to-Player Canopy Lanterns & Furnishings Store
    match /storeListings/{listingId} {
      allow get: if isSignedIn() &&
        isValidId(listingId) &&
        resource != null &&
        (existing().status == 'available' ||
          existing().sellerId == request.auth.uid ||
          existing().buyerId == request.auth.uid);

      allow list: if isSignedIn() &&
        (existing().status == 'available' ||
          existing().sellerId == request.auth.uid ||
          existing().buyerId == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(listingId) &&
        isValidStoreListing(incoming()) &&
        incoming().sellerId == request.auth.uid &&
        incoming().status == 'available' &&
        incoming().buyerId == '' &&
        incoming().proceedsClaimed == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (exists(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)) ||
          existsAfter(/databases/$(database)/documents/publicProfiles/$(incoming().sellerId)));

      allow update: if (
        isVerifiedUser() &&
        isValidId(listingId) &&
        isValidStoreListing(incoming()) &&
        incoming().sellerId == existing().sellerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().sellerId == request.auth.uid &&
            existing().status == 'available' &&
            incoming().itemKind == existing().itemKind &&
            incoming().buyerId == '' &&
            incoming().proceedsClaimed == false &&
            incoming().status in ['available', 'cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sellerName',
              'title',
              'craftNote',
              'priceTokens',
              'status',
              'updatedAt'
            ])) ||
          (existing().sellerId != request.auth.uid &&
            existing().status == 'available' &&
            incoming().status == 'sold' &&
            incoming().buyerId == request.auth.uid &&
            incoming().sellerName == existing().sellerName &&
            incoming().itemKind == existing().itemKind &&
            incoming().title == existing().title &&
            incoming().craftNote == existing().craftNote &&
            incoming().priceTokens == existing().priceTokens &&
            incoming().proceedsClaimed == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'buyerId',
              'updatedAt'
            ])) ||
          (existing().sellerId == request.auth.uid &&
            existing().status == 'sold' &&
            existing().proceedsClaimed == false &&
            incoming().status == 'sold' &&
            incoming().proceedsClaimed == true &&
            incoming().sellerName == existing().sellerName &&
            incoming().itemKind == existing().itemKind &&
            incoming().title == existing().title &&
            incoming().craftNote == existing().craftNote &&
            incoming().priceTokens == existing().priceTokens &&
            incoming().buyerId == existing().buyerId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'proceedsClaimed',
              'updatedAt'
            ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(listingId) &&
        existing().sellerId == request.auth.uid &&
        (existing().status in ['available', 'cancelled'] || existing().proceedsClaimed == true);
