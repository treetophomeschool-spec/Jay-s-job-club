# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PAYPAL_CLIENT_ID: PayPal REST Application Client ID for Welcome Area Handcrafted Shop checkout.
# Configure via the Secrets panel in AI Studio (never hardcode secrets in client code).
PAYPAL_CLIENT_ID=""

# PAYPAL_CLIENT_SECRET: PayPal REST Application Secret for server-side Orders v2 creation & capture.
# Used exclusively by server.ts (/api/paypal/*) and never exposed to the browser.
PAYPAL_CLIENT_SECRET=""

# PAYPAL_MODE: Set to "sandbox" for testing or "live" for real production PayPal payments.
PAYPAL_MODE="sandbox"

# PAYPAL_MERCHANT_EMAIL: Optional PayPal business payee email for order metadata.
PAYPAL_MERCHANT_EMAIL=""
